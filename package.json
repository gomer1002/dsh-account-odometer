{
  "name": "dsh-account-odometer",
  "version": "0.1.0",
  "description": "Shows the live DeepSeek account balance and this session's estimated spend in the DSH Web composer dock.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "cost"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": true
    },
    "client": {
      "platform": "web"
    }
  }
}
